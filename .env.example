# Variables de entorno del backend de "Súmate".
#
# Copiar a .env para desarrollo local (.env está en .gitignore) y crearlas en
# el panel de Railway para producción. NINGUNA de estas se sube al repositorio.
#
# El .env lo lee server.js al arrancar, sin ninguna librería. Lo que ya venga
# en el entorno NO se pisa, así que en Railway manda siempre el panel.
#
# Mientras falte cualquiera de las obligatorias, el formulario responde 503 y
# no acepta altas. Se puede comprobar el estado en GET /api/salud.

# --- Obligatorias -------------------------------------------------------------

# La pone sola el plugin de Postgres de Railway. En local, la de tu Postgres.
DATABASE_URL=postgres://usuario:clave@localhost:5432/poraguilas

# Credencial del panel del equipo. Mínimo 32 caracteres aleatorios.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# No se comparte por WhatsApp ni se escribe en ningún fichero del repositorio.
ADMIN_TOKEN=

# Secreto del que se derivan los enlaces de baja. Mínimo 32 caracteres.
# Generar igual que el anterior.
#
# AVISO IMPORTANTE: si esto cambia, TODOS los enlaces de baja repartidos hasta
# ese momento dejan de funcionar, y la gente se queda sin poder borrarse por su
# cuenta. No se rota salvo que haya un motivo de seguridad de peso.
SECRETO_HMAC=

# Dirección pública del sitio, sin barra final. Es la base de los enlaces que
# viajan en los correos, así que en producción tiene que ser la definitiva.
URL_BASE=https://poraguilas.es

# --- Correo -------------------------------------------------------------------

# Clave de la API de Brevo (Ajustes → SMTP y API → Claves de API).
# El dominio poraguilas.es tiene que estar verificado allí, con SPF, DKIM y
# DMARC puestos en el DNS, o los correos acabarán en spam.
BREVO_API_KEY=

# Remitente. La dirección tiene que ser del dominio verificado.
REMITENTE=no-responder@poraguilas.es
REMITENTE_NOMBRE=Por Águilas

# A dónde van las respuestas cuando alguien contesta a un correo automático.
# Este buzón tiene que existir y tiene que leerlo alguien.
RESPUESTA_A=hola@poraguilas.es

# Solo para desarrollo local: en vez de enviar, imprime el correo y el enlace
# por consola. Permite recorrer el alta entera sin cuenta de Brevo.
# NUNCA ponerlo a 1 en producción.
CORREO_EN_CONSOLA=0

# --- Conservación -------------------------------------------------------------

# Borrado total de la lista. Seis meses después de la jornada electoral.
# Al llegar esta fecha, la lista entera se borra sola. Está puesto a propósito:
# la finalidad para la que se recogieron los datos se agota con la campaña.
FECHA_PURGA_TOTAL=2027-11-30
